{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "packages/core/**/*.ts",
    "packages/memory-core/**/*.ts",
    "packages/policy/**/*.ts",
    "packages/runtime/**/*.ts",
    "packages/evaluation/**/*.ts",
    "packages/sibyl/**/*.ts",
    "packages/scenarios/provider-continuity/**/*.ts",
    "packages/virtuals-acp/**/*.ts",
    "packages/base-settlement/**/*.ts",
    "packages/benchmark/**/*.ts",
    "scripts/**/*.ts",
    "tests/integration/sibyl-*.test.ts",
    "tests/integration/benchmark-runner.test.ts",
    "tests/integration/virtuals-acp-evidence.test.ts",
    "tests/integration/base-settlement-*.test.ts",
    "tests/adapters/virtuals-acp-evidence.test.ts",
    "tests/scenarios/provider-continuity-memory.test.ts"
  ]
}
