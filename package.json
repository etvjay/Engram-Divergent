{
  "name": "engram-divergent",
  "private": true,
  "version": "0.1.0",
  "description": "Sibyl-native execution memory for autonomous agents",
  "type": "module",
  "bin": {
    "engram-mcp": "dist/scripts/engram-mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:sibyl",
    "test:primitives": "vitest run tests/primitives/behavioral-memory-lineage.test.ts",
    "test:benchmark": "vitest run tests/primitives/benchmark-contract.test.ts tests/integration/benchmark-runner.test.ts tests/integration/repeated-benchmark.test.ts",
    "benchmark:local": "tsx scripts/benchmark-local.ts",
    "benchmark:repeated": "tsx scripts/benchmark-repeated.ts",
    "benchmark:campaign": "tsx scripts/benchmark-campaign.ts",
    "model:conformance": "tsx scripts/model-conformance.ts",
    "test:sibyl": "ENGRAM_SIBYL_TEST_REQUIRED=1 vitest run tests/integration/sibyl-memory-loop.test.ts tests/integration/sibyl-provider-continuity.test.ts tests/integration/sibyl-competing-memories.test.ts tests/integration/sibyl-behavioral-memory-graph.test.ts tests/integration/acp-to-sibyl-durable-learning.test.ts",
    "test:virtuals": "vitest run tests/integration/virtuals-acp-evidence.test.ts tests/adapters/virtuals-acp-evidence.test.ts tests/integration/virtuals-acp-orchestration.test.ts tests/integration/acp-live-prepare.test.ts",
    "test:base": "vitest run tests/integration/base-settlement-authority.test.ts tests/integration/base-settlement-receipt.test.ts",
    "test:scenario": "vitest run tests/scenarios/provider-continuity-memory.test.ts",
    "test:evaluation": "ENGRAM_SIBYL_TEST_REQUIRED=1 vitest run tests/evaluation/*.test.ts tests/integration/sibyl-memory-update-lifecycle.test.ts tests/integration/cold-agent-surface.test.ts",
    "test:sdk": "ENGRAM_SIBYL_TEST_REQUIRED=1 vitest run tests/integration/sibyl-agent-sdk.test.ts",
    "test:api": "vitest run tests/api/rest.test.ts",
    "test:surface-lifecycle": "ENGRAM_SIBYL_TEST_REQUIRED=1 vitest run tests/api/cold-rest-lifecycle.test.ts tests/integration/engram-mcp-stdio-lifecycle.test.ts tests/integration/cold-agent-surface.test.ts tests/integration/sibyl-agent-sdk.test.ts tests/integration/engram-mcp-stdio-smoke.test.ts",
    "longitudinal:local": "tsx scripts/run-longitudinal-evaluation.ts",
    "demo:sibyl:seed": "tsx scripts/sibyl-demo.ts seed",
    "demo:sibyl:recall": "tsx scripts/sibyl-demo.ts recall",
    "demo:sibyl:no-memory-control": "tsx scripts/sibyl-demo.ts control",
    "test:sibyl:deletion": "tsx scripts/sibyl-demo.ts deletion",
    "demo:sibyl:provider:seed": "tsx scripts/sibyl-provider-demo.ts seed",
    "demo:sibyl:provider:urgent": "tsx scripts/sibyl-provider-demo.ts urgent",
    "demo:sibyl:provider:routine": "tsx scripts/sibyl-provider-demo.ts routine",
    "demo:sibyl:behavioral:seed": "tsx scripts/sibyl-behavioral-graph-demo.ts seed",
    "demo:sibyl:behavioral:load": "tsx scripts/sibyl-behavioral-graph-demo.ts load",
    "evidence:sibyl:capture": "tsx scripts/sibyl-evidence-capture.ts",
    "evidence:validate": "tsx scripts/validate-canonical-evidence.ts",
    "virtuals:acp:ingest": "tsx scripts/virtuals-acp-ingest.ts",
    "virtuals:acp:prepare": "tsx scripts/acp-live-prepare.ts",
    "acp:a0:v2": "tsx scripts/acp-a0-v2-continuous.ts",
    "tool-recovery:local": "ENGRAM_SIBYL_TEST_REQUIRED=1 vitest run tests/integration/tool-recovery-durable-learning.test.ts",
    "agent-handoff:local": "ENGRAM_SIBYL_TEST_REQUIRED=1 vitest run tests/integration/agent-handoff-durable-learning.test.ts",
    "agent-surface:mcp": "tsx scripts/engram-mcp.ts",
    "demo:engram": "tsx scripts/demo-engram.ts",
    "proof:judge": "ENGRAM_SIBYL_TEST_REQUIRED=1 tsx scripts/judge-proof.ts",
    "demo:fresh-session": "ENGRAM_SIBYL_TEST_REQUIRED=1 tsx scripts/judge-proof.ts --fresh-only",
    "base:settlement:verify": "tsx scripts/base-settlement-verify.ts",
    "check": "npm run build && npm run test:primitives && npm run test:benchmark && npm run test:sibyl && npm run test:scenario && npm run test:evaluation && npm run test:sdk && npm run test:virtuals && npm run tool-recovery:local && npm run agent-handoff:local && npm run test:base && npm run test:surface-lifecycle"
  },
  "dependencies": {
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@virtuals-protocol/acp-cli": "^1.0.35",
    "@virtuals-protocol/acp-node-v2": "^0.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
