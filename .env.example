# Sibyl is the only execution-memory backend in this repository.
# Use an explicit path so separate processes share the same memory store.
ENGRAM_SIBYL_DB=.sibyl/engram-divergent.db
ENGRAM_SIBYL_TENANT=engram-divergent

# Optional Python interpreter override for the Sibyl bridge.
# ENGRAM_SIBYL_PYTHON=python3

# Optional bridge path override for diagnostics.
# ENGRAM_SIBYL_BRIDGE=packages/sibyl/bridge.py

# Optional partner consequence/evidence integrations.
# Base verification is read-only and never needs a signer key.
# ENGRAM_BASE_RPC_URL=
# ENGRAM_BASE_EXPECTED_PAYER=

# Optional Virtuals ACP binary override. Default uses npx @virtuals-protocol/acp-cli.
# ENGRAM_ACP_BIN=acp
