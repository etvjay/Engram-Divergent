# CockroachDB application connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# Embedding provider: bedrock | ollama | vertex
ENGRAM_EMBEDDING_PROVIDER=ollama

# Ollama / local embedding profile
# Default is BGE-M3 on a local Ollama daemon. Keep 1024 while Engram's
# canonical Cockroach VECTOR schema is vector(1024).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIMENSIONS=1024

# AWS / Bedrock profile
AWS_REGION=us-west-2
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# GitHub Actions OIDC configuration (repository secret, not a browser/runtime value):
# AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/EngramGitHubLiveVerification

# Google Cloud / Vertex AI profile
# Prefer Application Default Credentials / Workload Identity Federation.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
# Keep 1024 while Engram's canonical Cockroach VECTOR schema is vector(1024).
VERTEX_EMBEDDING_DIMENSIONS=1024
# GitHub Actions WIF configuration (repository secrets, not runtime env vars):
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/NUMBER/locations/global/workloadIdentityPools/POOL/providers/PROVIDER
# GCP_SERVICE_ACCOUNT=engram-live-proof@PROJECT.iam.gserviceaccount.com

# Engram API deployment guard
# Required for every non-demo /v1 route. Do not expose this in a public browser bundle.
ENGRAM_API_TOKEN=

# CockroachDB Cloud Managed MCP (optional read/introspection plane for live proof)
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_CLUSTER_ID=
COCKROACH_MCP_API_KEY=
COCKROACH_MCP_DATABASE=defaultdb

# API CORS
CORS_ORIGIN=*
